{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Test: packages/db — run all",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--reporter=verbose"],
      "cwd": "${workspaceFolder}/packages/db",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "autoAttachChildProcesses": true,
      "smartStep": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Test: packages/db — watch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["--reporter=verbose"],
      "cwd": "${workspaceFolder}/packages/db",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "autoAttachChildProcesses": true,
      "smartStep": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Test: debug current file",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}", "--reporter=verbose"],
      "cwd": "${workspaceFolder}/packages/db",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "autoAttachChildProcesses": true,
      "smartStep": true
    }
  ]
}
